    {
      "role": "config",
      "uri": "https://raw.githubusercontent.com/caiyuanhao1998/Retinexformer/1e9a0efce4b306b6701b824768370ff26066c32a/Options/RetinexFormer_LOL_v1.yml",
      "revision": "1e9a0efce4b306b6701b824768370ff26066c32a",
