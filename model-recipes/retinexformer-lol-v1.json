    }
  ],
  "license": {
    "spdx": "MIT",
    "termsUri": "https://github.com/caiyuanhao1998/Retinexformer/blob/1e9a0efce4b306b6701b824768370ff26066c32a/LICENSE.txt",
    "redistributionAllowed": true,
    "commercialUseAllowed": true,
    "attribution": "Yuanhao Cai and Retinexformer authors, official LOL-v1 checkpoint and architecture, MIT"
  },
  "tensorContract": {
    "inputs": [
      {
        "shape": [1, 3, 256, 256],
        "dtype": "float32",
        "layout": "NCHW",
        "preprocess": {
          "channelOrder": "RGB",
          "mean": [0, 0, 0],
          "scale": [0.00392156862745098, 0.00392156862745098, 0.00392156862745098],
          "resize": {"filter": "bicubic", "fit": "exact"}
        }
      }
    ]
  },
  "outputContract": {"kind": "raw"},
  "preprocessing": {
    "kind": "image",
    "version": 1,
    "description": "Decode a bounded image to RGB, reject malformed or oversized inputs, bicubic-resize exactly to 256x256, convert to NCHW, and divide each byte channel by 255. Metadata and original full-resolution pixels never enter the model.",
    "artifacts": ["architecture", "config"]
  },
  "producer": {
    "kind": "retinexformer-image-enhancement",
    "version": 1,
    "inputNames": ["image"],
    "sourceOutputName": "enhanced",
    "sourceOutputShape": [1, 3, 256, 256],
    "outputShape": [1, 3, 256, 256],
    "postprocessing": "clamp-unit-range",
    "description": "Instantiate the pinned one-stage 40-feature LOL-v1 architecture, load the official state dict strictly, export a fixed 256x256 graph, name its image output enhanced, and clamp it to [0,1] inside the portable graph."
  },
  "evaluation": [
    {
      "metric": "portable-export-ssim",
      "comparator": "at-least",
      "target": 0.999,
      "unit": "ratio",
      "description": "Minimum portable-versus-native SSIM on frozen, license-reviewed low-light inputs."
    },
    {
      "metric": "paired-holdout-ssim",
      "comparator": "at-least",
      "target": 0.8,
      "unit": "ratio",
      "description": "Minimum enhancement SSIM on a separately licensed paired holdout; no repository dataset is bundled."
    },
    {
      "metric": "output-range-violation-rate",
      "comparator": "equal",
      "target": 0,
      "unit": "ratio",
      "description": "No portable output component may fall outside [0,1] or be non-finite."
    }
  ],
  "targets": {
    "tpu": {
      "status": "planned",
      "compiler": "edgetpu_compiler",
      "fullyQuantized": false,
      "reason": "Needs a representative fully-int8 TFLite export, full Edge TPU mapping, fidelity parity and execution evidence on Coral; none exists here."
    },
    "npu": {
      "status": "planned",
      "compiler": "ovc",
      "fullyQuantized": false,
      "reason": "Needs portable ONNX export, OpenVINO conversion, fidelity parity and execution evidence on the named NPU."
    },
    "gpu": {
      "status": "planned",
      "compiler": "pnnx",
      "fullyQuantized": false,
      "reason": "Needs fixed TorchScript export, ncnn conversion, fidelity parity and execution evidence on the named GPU."
    }
  }
}
