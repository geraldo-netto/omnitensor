{
  "recipeVersion": 1,
  "id": "all-minilm-l6-v2",
  "version": "1.0.0",
  "family": "embedding",
  "profileIds": ["document-intelligence"],
  "sourceFormat": "onnx",
  "sources": [
    {
      "role": "model",
      "uri": "https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/5641a7880f40ebf4035d05e60c5f9b7a9c272c84/onnx/model.onnx",
