{
  "manifestVersion": 2,
  "id": "file-organizer",
  "version": "1.1.0",
  "capabilities": ["explicit-file-selection", "review-only-file-organization"],
  "plugin": {
    "entryPoint": "file-organizer",
    "protocol": {"minimum": 1, "maximum": 1, "capabilities": ["cancel", "execute", "health", "progress"]},
    "schemas": {
      "configuration": {"type": "object", "additionalProperties": false},
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sources"],
        "properties": {
          "sources": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
        }
      },
      "output": {"$ref": "file-organizer-result.schema.json"}
    },
    "triggers": ["manual"],
    "artifacts": [
      {
        "id": "qwen3-5-9b-iq4-xs",
        "version": "1.0.0",
        "format": "gguf",
        "sha256": "7e918aeca06c52bcb528ea6b04b4ec957e75ee8c0a73138854c0dfcf371ea429",
        "sourceUri": "https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/main/Qwen3.5-9B-IQ4_XS.gguf",
        "licenseSpdx": "Apache-2.0"
      },
      {
        "id": "qwen3-8b-q4-k-m",
        "version": "1.0.0",
        "format": "gguf",
        "sha256": "d98cdcbd03e17ce47681435b5150e34c1417f50b5c0019dd560e4882c5745785",
        "sourceUri": "https://huggingface.co/Qwen/Qwen3-8B-GGUF/resolve/7c41481f57cb95916b40956ab2f0b139b296d974/Qwen3-8B-Q4_K_M.gguf",
        "licenseSpdx": "Apache-2.0"
      }
    ],
    "permissions": ["accelerator:gpu", "files:read-selected"]
  },
  "requirements": {"runtimeApi": 1, "accelerator": "gpu", "acceleratorPreference": ["gpu"], "minimumDevices": 1, "model": null},
  "ui": {"title": "File organizer", "group": "Local workflows", "description": "Review tags, names, folders, and exact duplicate groups", "icon": "folder-symbolic", "order": 94},
  "defaults": {"enabled": false, "weight": 1},
  "pipeline": {
    "hostResponsibilities": [
      "Broker only files selected for the current manual request",
      "Validate every suggestion against bounded private evidence",
      "Compute duplicate groups from exact file digests",
      "Expose a review-only plan with no filesystem mutation capability"
    ]
  },
  "acceptance": []
}
