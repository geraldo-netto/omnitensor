{
  "manifestVersion": 2,
  "id": "ask-selected-files",
  "version": "1.0.0",
  "capabilities": ["explicit-file-selection", "grounded-document-question-answering"],
  "plugin": {
    "entryPoint": "ask-selected-files",
    "protocol": {
      "minimum": 1,
      "maximum": 1,
      "capabilities": ["cancel", "execute", "health", "progress"]
    },
    "schemas": {
      "configuration": {"type": "object", "additionalProperties": false},
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sources", "question"],
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "question": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      },
      "output": {"$ref": "document-question-result.schema.json"}
    },
    "triggers": ["manual"],
    "artifacts": [],
    "permissions": ["files:read-selected"]
  },
  "requirements": {
    "runtimeApi": 1,
    "accelerator": "gpu",
    "acceleratorPreference": ["gpu"],
    "minimumDevices": 1,
    "model": null
  },
  "ui": {
    "title": "Ask selected files",
    "group": "Local workflows",
    "description": "BGE retrieval · grounded Qwen answers · exact citations",
    "icon": "system-search-symbolic",
    "order": 92
  },
  "defaults": {"enabled": false, "weight": 1},
  "pipeline": {
    "hostResponsibilities": [
      "Broker only files selected for the current manual request",
      "Build and discard a bounded private page-span index",
      "Require exact file, page, span, and digest citations on every answer"
    ]
  },
  "acceptance": []
}
