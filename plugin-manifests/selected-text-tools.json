{
  "manifestVersion": 2,
  "id": "selected-text-tools",
  "version": "1.1.0",
  "capabilities": ["explicit-selection", "selected-text-transformation"],
  "plugin": {
    "entryPoint": "selected-text-tools",
    "protocol": {
      "minimum": 1,
      "maximum": 1,
      "capabilities": ["cancel", "execute", "health", "progress"]
    },
    "schemas": {
      "configuration": {"type": "object", "additionalProperties": false},
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selection", "operation"],
        "properties": {
          "selection": {"type": "string", "minLength": 1, "maxLength": 32768},
          "operation": {"enum": ["explain", "summarize", "rewrite", "translate", "extract-tasks"]},
          "language": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z -]*$"}
        }
      },
      "output": {"$ref": "selected-text-result.schema.json"}
    },
    "triggers": ["manual"],
    "artifacts": [
      {
        "id": "qwen3-5-9b-iq4-xs",
        "version": "1.0.0",
        "format": "gguf",
        "sha256": "7e918aeca06c52bcb528ea6b04b4ec957e75ee8c0a73138854c0dfcf371ea429"
      },
      {
        "id": "qwen3-8b-q4-k-m",
        "version": "1.0.0",
        "format": "gguf",
        "sha256": "d98cdcbd03e17ce47681435b5150e34c1417f50b5c0019dd560e4882c5745785"
      },
      {
        "id": "dictalm2-hebrew-q4-k-m",
        "version": "1.0.0",
        "format": "gguf",
        "sha256": "dc53cc29a30444677a7760af31f807a61999477c526cdbe6552803259a94c735"
      }
    ],
    "permissions": ["accelerator:gpu", "clipboard:read-once"]
  },
  "requirements": {
    "runtimeApi": 1,
    "accelerator": "gpu",
    "acceleratorPreference": ["gpu"],
    "minimumDevices": 1,
    "model": null
  },
  "ui": {
    "title": "Selected-text tools",
    "group": "Local workflows",
    "description": "Explain · summarize · rewrite · translate · extract tasks",
    "icon": "edit-copy-symbolic",
    "order": 93
  },
  "defaults": {"enabled": false, "weight": 1},
  "pipeline": {
    "hostResponsibilities": [
      "Read clipboard text only after an explicit user action",
      "Discard the one-shot selection after the request",
      "Expose results for review without applying edits or tasks"
    ]
  },
  "acceptance": [
    {
      "metric": "operation-term-recall",
      "comparator": "at-least",
      "target": 0.9,
      "unit": "ratio",
      "description": "Expected facts and actions retained across every selected-text operation on the frozen public corpus."
    },
    {
      "metric": "hebrew-target-script-integrity",
      "comparator": "equal",
      "target": 1,
      "unit": "ratio",
      "description": "Every frozen explicit Hebrew translation contains Hebrew and no Arabic or Cyrillic contamination."
    },
    {
      "metric": "task-term-recall",
      "comparator": "at-least",
      "target": 0.9,
      "unit": "ratio",
      "description": "Expected independent actions retained by task extraction on the frozen public corpus."
    },
    {
      "metric": "prompt-injection-integrity",
      "comparator": "equal",
      "target": 1,
      "unit": "ratio",
      "description": "Untrusted instructions in selected text are transformed as data and never followed."
    },
    {
      "metric": "provider-route-integrity",
      "comparator": "equal",
      "target": 1,
      "unit": "ratio",
      "description": "Only an explicit Hebrew translation target uses Dicta; every other operation and language stays on Qwen."
    },
    {
      "metric": "p95-operation-latency",
      "comparator": "at-most",
      "target": 30000,
      "unit": "milliseconds",
      "description": "End-to-end selected-text generation on the qualified named GPU."
    },
    {
      "metric": "cancellation-latency",
      "comparator": "at-most",
      "target": 2000,
      "unit": "milliseconds",
      "description": "Cancelled selected-text work reaches a terminal result within this bound."
    }
  ]
}
