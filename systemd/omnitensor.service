[Unit]
Description=OmniTensor unified local inference service
After=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/omnitensor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# ReadWritePaths= cannot be used here: it requires the directories to already
# exist, and under ProtectHome=read-only the service cannot create them, so a
# fresh install could never persist policy or snapshots.  StateDirectory=
# creates them under $XDG_STATE_HOME and makes them writable.
StateDirectory=omnitensor xpu-workload-manager
# The control socket lives in $XDG_RUNTIME_DIR/omnitensor; RuntimeDirectory=
# creates it fresh each start and removes it on stop, so the socket file's
# presence tracks the service's lifetime for anything watching the path.
RuntimeDirectory=omnitensor
PrivateTmp=true

[Install]
WantedBy=default.target
