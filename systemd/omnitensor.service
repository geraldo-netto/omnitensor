[Unit]
Description=OmniTensor unified local inference service
After=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/omnitensor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/omnitensor
PrivateTmp=true

[Install]
WantedBy=default.target
