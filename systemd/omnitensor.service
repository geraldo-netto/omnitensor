[Unit]
Description=OmniTensor unified local inference service
# The service owns a name on the session bus; require the user D-Bus
# socket so a non-graphical session (WantedBy=default.target) cannot
# start it without a bus and spin in a restart loop.
Requires=dbus.socket
After=dbus.socket graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/omnitensor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# Own a cgroup subtree so each plugin worker can be accounted in its own
# cgroup.  Process-tree walking cannot see a worker that double-forks;
# cgroup membership survives it.
Delegate=yes
ProtectSystem=strict
ProtectHome=read-only
# ReadWritePaths= cannot be used here: it requires the directories to already
# exist, and under ProtectHome=read-only the service cannot create them, so a
# fresh install could never persist policy or snapshots.  StateDirectory=
# creates them under $XDG_STATE_HOME and makes them writable.
StateDirectory=omnitensor tpu-workload-manager
PrivateTmp=true

[Install]
WantedBy=default.target
