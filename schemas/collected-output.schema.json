{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/omnitensor/collected-output.schema.json",
  "title": "OmniTensor bounded collector output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "sourceHealth",
    "observedAtMs",
    "churn"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "enum": [
        "cgroup-systemd-pressure",
        "cinnamon-window-metadata",
        "hwmon-edac-power-service",
        "network-manager-link-metadata",
        "smart-nvme-io",
        "usb-bluetooth-health-metadata"
      ]
    },
    "sourceHealth": {
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ]
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "$ref": "#/$defs/items"
    },
    "links": {
      "$ref": "#/$defs/items"
    },
    "devices": {
      "$ref": "#/$defs/items"
    },
    "churn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/churnIdentity"
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/churnIdentity"
          }
        },
        "changed": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/churnChange"
          }
        }
      }
    },
    "kernelTelemetry": {
      "$ref": "#/$defs/kernelTelemetry"
    },
    "kernelFeatures": {
      "$ref": "#/$defs/kernelFeatures"
    }
  },
  "oneOf": [
    {
      "properties": {
        "source": {
          "enum": [
            "cgroup-systemd-pressure",
            "cinnamon-window-metadata",
            "hwmon-edac-power-service",
            "smart-nvme-io"
          ]
        }
      },
      "required": [
        "items"
      ],
      "not": {
        "anyOf": [
          {
            "required": ["links"]
          },
          {
            "required": ["devices"]
          }
        ]
      }
    },
    {
      "properties": {
        "source": {
          "const": "network-manager-link-metadata"
        }
      },
      "required": [
        "links"
      ],
      "not": {
        "anyOf": [
          {
            "required": ["items"]
          },
          {
            "required": ["devices"]
          }
        ]
      }
    },
    {
      "properties": {
        "source": {
          "const": "usb-bluetooth-health-metadata"
        }
      },
      "required": [
        "devices"
      ],
      "not": {
        "anyOf": [
          {
            "required": ["items"]
          },
          {
            "required": ["links"]
          }
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "cgroup-systemd-pressure"
          }
        }
      },
      "then": {
        "required": [
          "kernelTelemetry",
          "kernelFeatures"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": ["kernelTelemetry"]
            },
            {
              "required": ["kernelFeatures"]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "items": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "maxProperties": 32
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._:@/-]{0,78}[a-z0-9])?$"
    },
    "churnIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "stableId": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "oneOf": [
        {
          "required": ["id"]
        },
        {
          "required": ["stableId"]
        }
      ]
    },
    "churnChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "stableId": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "bus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "oneOf": [
        {
          "required": ["id"]
        },
        {
          "required": ["stableId"]
        }
      ]
    },
    "kernelCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "kernelTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "state",
        "detail",
        "collectedAtMs",
        "histograms",
        "counters"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "enum": [
            "ready",
            "helper-absent",
            "helper-unreachable",
            "helper-invalid"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 240
        },
        "collectedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "histograms": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "unit",
              "buckets"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "buckets": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/kernelCount"
                }
              }
            }
          }
        },
        "counters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "value": {
                "$ref": "#/$defs/kernelCount"
              }
            }
          }
        }
      }
    },
    "kernelFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kernelRunQueueSamples": {
          "$ref": "#/$defs/kernelFeature"
        },
        "kernelRunQueueP50UpperUs": {
          "$ref": "#/$defs/kernelFeature"
        },
        "kernelRunQueueP95UpperUs": {
          "$ref": "#/$defs/kernelFeature"
        },
        "kernelBlockIoSamples": {
          "$ref": "#/$defs/kernelFeature"
        },
        "kernelBlockIoP50UpperUs": {
          "$ref": "#/$defs/kernelFeature"
        },
        "kernelBlockIoP95UpperUs": {
          "$ref": "#/$defs/kernelFeature"
        }
      }
    },
    "kernelFeature": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
