{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnitensor/file-organizer-answer.schema.json",
  "title": "Private selected-file organization suggestions",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "suggestions"],
  "properties": {
    "version": {"const": 1},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
    "suggestions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/suggestion"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceSha256", "page", "span", "textSha256"],
      "properties": {
        "sourceRef": {"type": "string", "pattern": "^private:[A-Za-z0-9._:-]{1,220}$"},
        "sourceSha256": {"$ref": "#/$defs/digest"},
        "page": {"type": "integer", "minimum": 1},
        "span": {"$ref": "#/$defs/span"},
        "textSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "tags", "proposedName", "proposedFolder", "reason", "evidence"],
      "properties": {
        "fileId": {"type": "string", "pattern": "^selected-file-[1-9][0-9]*$"},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "proposedName": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "proposedFolder": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
