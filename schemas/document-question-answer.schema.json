{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnitensor/document-question-answer.schema.json",
  "title": "Grounded selected-file answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "answer", "citations"],
  "properties": {
    "version": {"const": 1},
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,120}$"
    },
    "answer": {"type": "string", "minLength": 1},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/citation"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceSha256", "page", "span", "textSha256"],
      "properties": {
        "sourceRef": {
          "type": "string",
          "pattern": "^private:[A-Za-z0-9._:-]{1,220}$"
        },
        "sourceSha256": {"$ref": "#/$defs/digest"},
        "page": {"type": "integer", "minimum": 1, "maximum": 2000},
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "integer", "minimum": 0, "maximum": 5000000},
            "end": {"type": "integer", "minimum": 1, "maximum": 5000000}
          }
        },
        "textSha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
