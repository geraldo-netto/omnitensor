{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/tpu-workload-manager/workload-manifest.schema.json",
  "title": "TPU Workload Manager workload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "capabilities",
    "requirements",
    "ui",
    "defaults",
    "pipeline",
    "acceptance"
  ],
  "properties": {
    "manifestVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryPoint",
        "protocol",
        "schemas",
        "triggers",
        "artifacts",
        "permissions"
      ],
      "properties": {
        "entryPoint": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 80
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "capabilities": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration",
            "input",
            "output"
          ],
          "properties": {
            "configuration": {
              "type": "object",
              "maxProperties": 64
            },
            "input": {
              "type": "object",
              "maxProperties": 64
            },
            "output": {
              "type": "object",
              "maxProperties": 64
            }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "manual",
              "periodic",
              "event"
            ]
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "format",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 120
              },
              "version": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
                "maxLength": 32
              },
              "format": {
                "enum": [
                  "tflite-edgetpu",
                  "tflite",
                  "onnx",
                  "openvino",
                  "ncnn"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9*._/-]+$",
            "minLength": 3,
            "maxLength": 160
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeApi",
        "accelerator",
        "minimumDevices",
        "model"
      ],
      "properties": {
        "runtimeApi": {
          "const": 1
        },
        "accelerator": {
          "enum": [
            "tpu",
            "npu",
            "gpu"
          ]
        },
        "acceleratorPreference": {
          "description": "Ordered routing intent. The first entry must be the accelerator the profile was designed for; the rest are fallbacks in order. Omitted means the global tpu > npu > gpu default.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tpu",
              "npu",
              "gpu"
            ]
          }
        },
        "minimumDevices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "model": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "format",
            "fullyQuantized",
            "minimumCompilerVersion",
            "minimumRuntimeVersion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 120
            },
            "version": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
              "maxLength": 32
            },
            "format": {
              "enum": [
                "tflite-edgetpu",
                "tflite",
                "onnx",
                "openvino",
                "ncnn"
              ]
            },
            "fullyQuantized": {
              "type": "boolean"
            },
            "minimumCompilerVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minimumRuntimeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sha256": {
              "description": "Digest of the exact artifact this profile may run. Optional for compatibility with manifests written before dispatch verified it; when absent the runtime can only trust the digest recorded when the artifact was installed.",
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "tensorContract": {
              "description": "What this model expects of its input. Absent means no check: a manifest written before this field still loads and still runs. Split deliberately in two \u2014 shape and dtype are facts the runtime enforces at admission, while preprocess is advice for whoever turns a picture into a buffer and is never enforced, because the runtime decodes nothing and cannot tell a correctly normalised tensor from a wrong one.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inputs"
              ],
              "properties": {
                "inputs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "shape",
                      "dtype"
                    ],
                    "properties": {
                      "shape": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65536
                        }
                      },
                      "dtype": {
                        "enum": [
                          "float32",
                          "float64",
                          "int32",
                          "int64",
                          "uint8"
                        ]
                      },
                      "layout": {
                        "enum": [
                          "NCHW",
                          "NHWC",
                          "NC",
                          "N"
                        ]
                      },
                      "preprocess": {
                        "description": "How the values were produced, for a caller that has pixels and needs a buffer. Stated by the publisher because nothing in the artifact records it: an ncnn .param declares its input size and says nothing about mean subtraction or channel order, and a tensor normalised the wrong way infers successfully and means nothing.",
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "channelOrder",
                          "mean",
                          "scale"
                        ],
                        "properties": {
                          "channelOrder": {
                            "enum": [
                              "RGB",
                              "BGR",
                              "GRAY"
                            ]
                          },
                          "mean": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 4,
                            "items": {
                              "type": "number"
                            }
                          },
                          "scale": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 4,
                            "items": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accelerator": {
                "const": "tpu"
              }
            },
            "required": [
              "accelerator"
            ]
          },
          "then": {
            "properties": {
              "model": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "format": {
                        "const": "tflite-edgetpu"
                      },
                      "fullyQuantized": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accelerator": {
                "const": "tpu"
              }
            },
            "required": [
              "accelerator"
            ]
          },
          "then": {
            "properties": {
              "acceleratorPreference": {
                "prefixItems": [
                  {
                    "const": "tpu"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accelerator": {
                "const": "npu"
              }
            },
            "required": [
              "accelerator"
            ]
          },
          "then": {
            "properties": {
              "acceleratorPreference": {
                "prefixItems": [
                  {
                    "const": "npu"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "accelerator": {
                "const": "gpu"
              }
            },
            "required": [
              "accelerator"
            ]
          },
          "then": {
            "properties": {
              "acceleratorPreference": {
                "prefixItems": [
                  {
                    "const": "gpu"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "group",
        "description",
        "icon",
        "order"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-symbolic$",
          "minLength": 10,
          "maxLength": 120
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "weight"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostResponsibilities"
      ],
      "properties": {
        "hostResponsibilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "comparator",
          "target",
          "unit",
          "description"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 80
          },
          "comparator": {
            "enum": [
              "at-least",
              "at-most",
              "equal"
            ]
          },
          "target": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "manifestVersion": {
          "const": 1
        }
      },
      "not": {
        "required": [
          "plugin"
        ]
      }
    },
    {
      "properties": {
        "manifestVersion": {
          "const": 2
        }
      },
      "required": [
        "plugin"
      ]
    }
  ]
}
