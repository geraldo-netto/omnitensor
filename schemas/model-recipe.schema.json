{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/omnitensor/model-recipe.schema.json",
  "title": "OmniTensor portable model recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipeVersion",
    "id",
    "version",
    "family",
    "profileIds",
    "sourceFormat",
    "sources",
    "license",
    "tensorContract",
    "outputContract",
    "evaluation",
    "targets"
  ],
  "properties": {
    "recipeVersion": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "family": {
      "enum": [
        "anomaly",
        "classification",
        "context",
        "embedding",
        "forecast",
        "low-light",
        "ranking"
      ]
    },
    "profileIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "sourceFormat": {
      "enum": ["onnx", "safetensors", "tflite", "torchscript"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/source"}
    },
    "license": {"$ref": "#/$defs/license"},
    "tensorContract": {
      "description": "Validated against the canonical workload model contract by the loader.",
      "type": "object"
    },
    "outputContract": {
      "description": "Validated against the canonical workload model contract by the loader.",
      "type": "object"
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "description"],
      "properties": {
        "kind": {"enum": ["image", "numeric-window", "text"]},
        "version": {"type": "integer", "minimum": 1, "maximum": 65535},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "artifacts": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "enum": ["config", "labels", "tokenizer", "vocabulary"]
          }
        }
      }
    },
    "evaluation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/metric"}
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tpu", "npu", "gpu"],
      "properties": {
        "tpu": {"$ref": "#/$defs/target"},
        "npu": {"$ref": "#/$defs/target"},
        "gpu": {"$ref": "#/$defs/target"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "uri", "revision", "filename", "sha256", "sizeBytes"],
      "properties": {
        "role": {
          "enum": ["config", "labels", "model", "tokenizer", "vocabulary"]
        },
        "uri": {
          "type": "string",
          "pattern": "^https://",
          "minLength": 12,
          "maxLength": 2048
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 7,
          "maxLength": 80
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "termsUri",
        "redistributionAllowed",
        "commercialUseAllowed",
        "attribution"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+$",
          "minLength": 1,
          "maxLength": 80
        },
        "termsUri": {
          "type": "string",
          "pattern": "^https://",
          "minLength": 12,
          "maxLength": 2048
        },
        "redistributionAllowed": {"const": true},
        "commercialUseAllowed": {"const": true},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "comparator", "target", "unit", "description"],
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 80
        },
        "comparator": {"enum": ["at-least", "at-most", "equal"]},
        "target": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 40},
        "description": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compiler", "fullyQuantized", "reason"],
      "properties": {
        "status": {"enum": ["planned", "convertible", "validated", "incompatible"]},
        "compiler": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "fullyQuantized": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "evidenceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "validated"}}},
          "then": {"required": ["evidenceSha256"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["convertible", "validated"]}}},
          "then": {"properties": {"compiler": {"type": "string"}}}
        }
      ]
    }
  }
}
