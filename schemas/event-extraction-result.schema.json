{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnitensor.local/schemas/event-extraction-result.schema.json",
  "title": "Event extraction result",
  "description": "Version 2. An event is recorded with whatever the source states and says what it still needs; incomplete is not the same as absent. Version 1 required a full datetime and a named timezone on every event, which no ordinary invitation supplies, so the only satisfiable answer was a refusal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "outcome", "code", "detail", "duplicatePolicy", "confirmationState", "events"],
  "properties": {
    "version": {"const": 2},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
    "outcome": {"enum": ["succeeded", "partial", "refused"]},
    "code": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "detail": {"type": "string", "maxLength": 500},
    "duplicatePolicy": {"const": "keep-first-label-date-time-place"},
    "confirmationState": {"enum": ["pending", "confirmed", "mixed", "refused"]},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "description": "Where the value came from. A title read off the page and a title the model wrote must not look alike to the person deciding.",
      "enum": ["stated", "summarised", "deduced"]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "time": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}([0-9:]{3})?$"},
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "time": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}
      }
    },
    "timezone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "utcOffset": {
          "description": "Filled only when the date is known, because the offset depends on it: Europe/Lisbon is +00:00 in January and +01:00 in July.",
          "oneOf": [{"type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$"}, {"type": "null"}]
        },
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "description": "`date` is required so that both moment slots always exist. Measured 2026-08-17: with `date` optional the model filled exactly one of date and time on 8 of 8 events, never both, and reported `needs: []` while doing it. A source that states no date says so with the literal `unknown`, which the grammar can enforce where a conditional cannot — llama.cpp drops `if`/`then` silently.",
      "required": ["needs", "date"],
      "properties": {
        "date": {"oneOf": [{"$ref": "#/$defs/date"}, {"const": "unknown"}]},
        "time": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "end": {"oneOf": [{"$ref": "#/$defs/moment"}, {"type": "null"}]},
        "allDay": {"type": "boolean"},
        "timezone": {"oneOf": [{"$ref": "#/$defs/timezone"}, {"type": "null"}]},
        "needs": {
          "description": "What the person must supply before this can be placed in a calendar. A missing location blocks nothing and is never listed. Bounded because `uniqueItems` is not enforced by the grammar: one case returned four thousand characters of a repeating list.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {"enum": ["date", "time", "timezone"]}
        },
        "isPast": {"type": "boolean"}
      }
    },
    "repeats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freq", "text", "source"],
      "properties": {
        "freq": {"enum": ["SECONDLY", "MINUTELY", "HOURLY", "DAILY", "WEEKLY", "MONTHLY", "YEARLY"]},
        "interval": {"type": "integer", "minimum": 1},
        "byDay": {"type": "array", "items": {"type": "string", "pattern": "^[+-]?([1-9]|[1-4][0-9]|5[0-3])?(MO|TU|WE|TH|FR|SA|SU)$"}},
        "byMonthDay": {"type": "array", "items": {"type": "integer", "minimum": -31, "maximum": 31}},
        "byMonth": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}},
        "bySetPos": {"type": "array", "items": {"type": "integer", "minimum": -366, "maximum": 366}},
        "count": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "until": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/date"}},
        "text": {
          "description": "The phrase the rule was read from, so a person can check it without reconstructing RFC 5545 in their head.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "description": "Only ever stated. A rule nobody wrote down is not deduced from two dates a week apart.",
          "const": "stated"
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full"],
      "properties": {
        "street": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]},
        "postalCode": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 32}, {"type": "null"}]},
        "city": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 120}, {"type": "null"}]},
        "region": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 120}, {"type": "null"}]},
        "country": {"oneOf": [{"type": "string", "minLength": 2, "maxLength": 60}, {"type": "null"}]},
        "full": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["physical", "online", "hybrid", "unknown"]},
        "venue": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]},
        "address": {"oneOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
        "url": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}]},
        "joining": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "email": {"oneOf": [{"type": "string", "minLength": 3, "maxLength": 320}, {"type": "null"}]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "people": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organiser": {"oneOf": [{"$ref": "#/$defs/person"}, {"type": "null"}]},
        "participants": {"type": "array", "items": {"$ref": "#/$defs/person"}}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^\\d{1,12}(\\.\\d{1,4})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "required": {"type": "boolean"},
        "deadline": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "url": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}]},
        "cost": {"oneOf": [{"$ref": "#/$defs/cost"}, {"type": "null"}]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "email": {"oneOf": [{"type": "string", "minLength": 3, "maxLength": 320}, {"type": "null"}]},
        "phone": {"oneOf": [{"type": "string", "minLength": 3, "maxLength": 64}, {"type": "null"}]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceSha256", "page", "span", "textSha256", "readAs"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1, "maxLength": 200},
        "sourceSha256": {"$ref": "#/$defs/digest"},
        "page": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "integer", "minimum": 0},
            "end": {"type": "integer", "minimum": 0}
          }
        },
        "textSha256": {"$ref": "#/$defs/digest"},
        "readAs": {
          "description": "How the text the span addresses was obtained. A span into the OCR of a crooked banner is a much weaker citation than a span into an email body.",
          "enum": ["text", "ocr"]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "label", "when", "confirmation", "evidence"],
      "properties": {
        "candidateId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
        "label": {"$ref": "#/$defs/text"},
        "what": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "when": {"$ref": "#/$defs/when"},
        "repeats": {"oneOf": [{"$ref": "#/$defs/repeats"}, {"type": "null"}]},
        "where": {"oneOf": [{"$ref": "#/$defs/where"}, {"type": "null"}]},
        "people": {"oneOf": [{"$ref": "#/$defs/people"}, {"type": "null"}]},
        "status": {"enum": ["scheduled", "tentative", "postponed", "cancelled"]},
        "registration": {"oneOf": [{"$ref": "#/$defs/registration"}, {"type": "null"}]},
        "contact": {"oneOf": [{"$ref": "#/$defs/contact"}, {"type": "null"}]},
        "reference": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}]},
        "language": {"oneOf": [{"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}, {"type": "null"}]},
        "confirmation": {"enum": ["pending", "confirmed", "rejected"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
