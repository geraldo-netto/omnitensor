{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/omnitensor/runtime-job-acknowledgement.schema.json",
  "title": "OmniTensor runtime job acknowledgement version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestId",
    "jobId",
    "status",
    "code",
    "message",
    "timestamp"
  ],
  "properties": {
    "version": {"const": 1},
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,120}$"
    },
    "jobId": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._-]{1,120}$"
    },
    "status": {
      "enum": ["accepted", "cancelled", "rejected", "not-found"]
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 240},
    "timestamp": {"type": "integer", "minimum": 1}
  }
}
