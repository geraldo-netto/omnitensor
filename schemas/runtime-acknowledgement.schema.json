{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/xpu-workload-manager/runtime-acknowledgement.schema.json",
  "title": "XPU Workload Manager runtime acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "commandId",
    "status",
    "revision",
    "appliedAt",
    "message",
    "portfolio"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "applied",
        "rejected"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "appliedAt": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string"
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paused",
        "profiles",
        "deviceChoices",
        "modelChoices"
      ],
      "properties": {
        "paused": {
          "type": "boolean"
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "weight"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        },
        "deviceChoices": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^gpu-renderD[0-9]{1,6}$"
          }
        },
        "modelChoices": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        }
      }
    }
  }
}
