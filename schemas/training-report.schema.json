{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/omnitensor/training-report.schema.json",
  "title": "OmniTensor forecast training report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recipe",
    "spec",
    "samples",
    "corpusSha256",
    "model",
    "quality",
    "tensorContract",
    "outputContract"
  ],
  "properties": {
    "version": {"const": 1},
    "recipe": {"const": "forecast-v1"},
    "spec": {"$ref": "#/$defs/spec"},
    "samples": {"type": "integer", "minimum": 1},
    "corpusSha256": {"$ref": "#/$defs/sha256"},
    "model": {"$ref": "#/$defs/model"},
    "quality": {"$ref": "#/$defs/quality"},
    "tensorContract": {"$ref": "#/$defs/tensorContract"},
    "outputContract": {"$ref": "#/$defs/outputContract"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "artifactId",
        "artifactVersion",
        "featureNames",
        "targetFeature",
        "window",
        "horizon"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 80
        },
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 116
        },
        "artifactVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "featureNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "targetFeature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "window": {"type": "integer", "minimum": 1, "maximum": 128},
        "horizon": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "filename", "sha256"],
      "properties": {
        "format": {"const": "onnx"},
        "filename": {"const": "model.onnx"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tensorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/input"}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "dtype", "layout"],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{"const": 1}],
          "items": {"type": "integer", "minimum": 1, "maximum": 65536}
        },
        "dtype": {"const": "float32"},
        "layout": {"const": "NC"}
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "raw"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "jsonValue": {
      "anyOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    }
  }
}
