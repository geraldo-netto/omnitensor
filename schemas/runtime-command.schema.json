{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/xpu-workload-manager/runtime-command.schema.json",
  "title": "XPU Workload Manager runtime command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "issuedAt",
    "expectedRevision",
    "operation",
    "profileId",
    "value"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1,
      "maxLength": 120
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "enum": [
        "set-profile-enabled",
        "set-profile-weight",
        "set-profile-device",
        "set-profile-model",
        "set-profile-configuration",
        "set-paused",
        "apply-profiles"
      ]
    },
    "profileId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^gpu-renderD[0-9]{1,6}$"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "description": "Several profile settings applied as one command, one revision, and one acknowledgement. Sending them separately spends a call and a revision each, and a failure part-way leaves policy half-applied with no way to retry the rest as a unit — the batch either applies whole or changes nothing.",
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId"
        ],
        "properties": {
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "enabled": {
            "type": "boolean"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "deviceId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^gpu-renderD[0-9]{1,6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-profile-device"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^gpu-renderD[0-9]{1,6}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "changes": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-profile-model"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "changes": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-profile-configuration"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "string"
          },
          "value": {
            "description": "The configuration a person chose, validated against the schema that workload's own manifest declares rather than against this one. Unbounded here on purpose: the settings store holds the document-size limit, and a ceiling stated twice is a ceiling that drifts.",
            "type": "object"
          },
          "changes": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-profile-enabled"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "string"
          },
          "value": {
            "type": "boolean"
          },
          "changes": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-profile-weight"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "changes": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-paused"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "null"
          },
          "value": {
            "type": "boolean"
          },
          "changes": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "apply-profiles"
          }
        }
      },
      "then": {
        "properties": {
          "profileId": {
            "type": "null"
          },
          "value": {
            "type": "null"
          }
        },
        "required": [
          "changes"
        ]
      }
    }
  ]
}
