{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omnitensor/selected-text-answer.schema.json",
  "title": "Grounded selected-text result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "operation", "result", "tasks", "evidence"],
  "properties": {
    "version": {"const": 1},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"},
    "operation": {"enum": ["explain", "summarize", "rewrite", "translate", "extract-tasks"]},
    "result": {"type": "string", "minLength": 1, "maxLength": 16384},
    "tasks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceSha256", "span", "textSha256"],
      "properties": {
        "sourceRef": {"type": "string", "pattern": "^private:[A-Za-z0-9._:-]{1,220}$"},
        "sourceSha256": {"$ref": "#/$defs/digest"},
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"const": 0},
            "end": {"type": "integer", "minimum": 1, "maximum": 32768}
          }
        },
        "textSha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
