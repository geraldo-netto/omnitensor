{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/xpu-workload-manager/runtime-snapshot.schema.json",
  "title": "XPU Workload Manager runtime snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "devices",
    "metrics",
    "profiles",
    "alerts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 1
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "backend",
          "available",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "backend": {
            "enum": [
              "tpu",
              "npu",
              "gpu"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "usb",
              "pcie",
              "accel",
              "dri",
              "unknown"
            ]
          },
          "vendor": {
            "type": "string",
            "maxLength": 80
          },
          "load": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queueDepth",
        "runningProfiles"
      ],
      "properties": {
        "queueDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "runningProfiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "running",
              "watching",
              "idle",
              "paused",
              "unavailable"
            ]
          },
          "queued": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "detail": {
            "type": "string",
            "maxLength": 240
          },
          "reason": {
            "description": "Machine-readable counterpart to detail: what kind of problem this is, so a consumer chooses a remedy without matching English prose.",
            "enum": [
              "serving",
              "paused-by-policy",
              "profile-disabled",
              "no-model",
              "artifact-unavailable",
              "consent-missing",
              "device-absent",
              "runtime-missing",
              "runtime-unusable",
              "format-unsupported",
              "no-executor",
              "no-preference"
            ]
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profileId",
          "title",
          "summary",
          "severity",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          },
          "severity": {
            "enum": [
              "advisory",
              "warning",
              "critical"
            ]
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "riskScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "resolved": {
            "type": "boolean"
          },
          "resultRef": {
            "type": "string",
            "pattern": "^result-[A-Za-z0-9._-]+$",
            "minLength": 8,
            "maxLength": 120
          }
        }
      }
    },
    "inputs": {
      "description": "Where a caller may stage a referenced input buffer, and how large one may be. Absent means the runtime predates the field. Empty roots mean it will read no referenced file at all, which is the default: reading a path a caller names is a capability, not something that is on unless configured off. A consumer cannot infer these paths and must not guess them, because a buffer written anywhere else is refused with the same answer as a path that does not exist.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "maxBytes"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        }
      }
    },
    "kernelTelemetry": {
      "description": "Bounded aggregate-only kernel latency telemetry. No process, user, cgroup, path, or payload identity is permitted in this block.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "state",
        "detail",
        "collectedAtMs",
        "histograms",
        "counters"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "enum": [
            "ready",
            "helper-absent",
            "helper-unreachable",
            "helper-invalid"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 240
        },
        "collectedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "histograms": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "unit",
              "buckets"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "buckets": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/kernelCount"
                }
              }
            }
          }
        },
        "counters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "value": {
                "$ref": "#/$defs/kernelCount"
              }
            }
          }
        }
      }
    },
    "pluginTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "plugins"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "plugins": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "health",
              "stage",
              "artifactReadiness",
              "queuedJobs",
              "activeJobs",
              "lastSuccessAt",
              "lastErrorCode",
              "lastErrorAt",
              "deadlineExceeded",
              "retries",
              "cancellations",
              "drops",
              "successes",
              "failures"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 80
              },
              "health": {
                "enum": [
                  "initializing",
                  "healthy",
                  "degraded",
                  "unavailable",
                  "stopped"
                ]
              },
              "stage": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "collect",
                  "preprocess",
                  "resolve",
                  "infer",
                  "postprocess",
                  "deliver",
                  "terminal"
                ]
              },
              "artifactReadiness": {
                "enum": [
                  "unknown",
                  "resolving",
                  "ready",
                  "missing",
                  "rejected",
                  "incompatible"
                ]
              },
              "queuedJobs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "activeJobs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
              },
              "lastSuccessAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastErrorCode": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 80
              },
              "lastErrorAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deadlineExceeded": {
                "$ref": "#/$defs/telemetryCounter"
              },
              "retries": {
                "$ref": "#/$defs/telemetryCounter"
              },
              "cancellations": {
                "$ref": "#/$defs/telemetryCounter"
              },
              "drops": {
                "$ref": "#/$defs/telemetryCounter"
              },
              "successes": {
                "$ref": "#/$defs/telemetryCounter"
              },
              "failures": {
                "$ref": "#/$defs/telemetryCounter"
              }
            }
          }
        }
      }
    },
    "policy": {
      "description": "The policy this runtime is enforcing, from the same store that answers apply-command. A client sets these and renders them back rather than keeping its own copy: two stores for one fact drift, and the one a window draws is not the one a scheduler obeys. Absent means the runtime predates the field, and a consumer that finds it absent falls back to whatever it did before. The revision is the value to send as expectedRevision, so a client that has read a snapshot never has to guess it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "paused",
        "profiles"
      ],
      "properties": {
        "revision": {
          "description": "Increments on every applied command; what to send as expectedRevision.",
          "type": "integer",
          "minimum": 0
        },
        "paused": {
          "description": "Whether every profile is held. Runtime state: a pause that ended when a window closed would not be a pause.",
          "type": "boolean"
        },
        "profiles": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "weight"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "deviceId": {
                "description": "The card this profile is pinned to, when a person pinned one. Absent means the runtime chooses.",
                "type": "string",
                "pattern": "^gpu-renderD[0-9]{1,6}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kernelCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "telemetryCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    }
  }
}
