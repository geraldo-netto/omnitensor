{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinnamon.org/omnitensor/plugin-inventory.schema.json",
  "title": "OmniTensor plugin inventory",
  "description": "Read-only description of installed plugins: what each declares, what it still needs, and whether it can run. Contains no configuration values, because a value can be a resolved secret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "plugins"],
  "properties": {
    "version": {"const": 1},
    "generatedAt": {"type": "integer", "minimum": 1},
    "plugins": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source",
        "distribution",
        "workerState",
        "protocol",
        "triggers",
        "artifacts",
        "permissions",
        "configurationSchema",
        "secretConfigurationKeys"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 40},
        "source": {"enum": ["bundled", "external"]},
        "distribution": {"type": "string", "minLength": 1, "maxLength": 160},
        "workerState": {
          "type": ["string", "null"],
          "enum": [
            "starting",
            "ready",
            "failed",
            "exited",
            "restarting",
            "exhausted",
            "stopped",
            null
          ]
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "capabilities"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1, "maximum": 65535},
            "maximum": {"type": "integer", "minimum": 1, "maximum": 65535},
            "capabilities": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["manual", "periodic", "event"]}
        },
        "artifacts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "format", "ready", "reason"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 120
              },
              "version": {"type": "string", "minLength": 1, "maxLength": 40},
              "format": {"type": "string", "minLength": 1, "maxLength": 40},
              "ready": {"type": "boolean"},
              "reason": {"type": "string", "maxLength": 240}
            }
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "granted"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9*._/-]+$",
                "minLength": 3,
                "maxLength": 160
              },
              "granted": {"type": "boolean"}
            }
          }
        },
        "configurationSchema": {"type": "object", "maxProperties": 64},
        "secretConfigurationKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    }
  }
}
