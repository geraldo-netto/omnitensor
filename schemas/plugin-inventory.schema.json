{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinnamon.org/omnitensor/plugin-inventory.schema.json",
  "title": "OmniTensor plugin inventory",
  "description": "Read-only description of installed plugins: what each declares, what it still needs, and whether it can run. Stored configuration values are published with every key named in secretConfigurationKeys withheld, because a withheld value can be a resolved secret; a secret-marked key never appears in configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "plugins"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source",
        "distribution",
        "workerState",
        "protocol",
        "triggers",
        "artifacts",
        "permissions",
        "configurationSchema",
        "secretConfigurationKeys"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "source": {
          "enum": [
            "bundled",
            "external"
          ]
        },
        "distribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "workerState": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "starting",
            "ready",
            "failed",
            "exited",
            "restarting",
            "exhausted",
            "stopped",
            null
          ]
        },
        "workerDetail": {
          "description": "Why a worker is not running, when the runtime has something to say. Optional: an entry that always carried it would be a field an older applet rejects, and its record is closed.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum",
            "capabilities"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "capabilities": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "manual",
              "periodic",
              "event"
            ]
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "format",
              "ready",
              "reason",
              "selectable"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 120
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "format": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "ready": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 240
              },
              "selectable": {
                "description": "Whether a person may choose this artifact as the model this workload runs. A manifest pins every artifact a workload uses, and most use one nobody picks — the embedder behind a document question, the named model behind one target language, the transcriber behind a recording — so a dropdown built from this list without reading this field offers a model that ends at a worker which cannot do the work.",
                "type": "boolean"
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "granted"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9*._/-]+$",
                "minLength": 3,
                "maxLength": 160
              },
              "granted": {
                "type": "boolean"
              }
            }
          }
        },
        "configurationSchema": {
          "type": "object",
          "maxProperties": 64
        },
        "inputSchema": {
          "description": "Verbatim copy of the manifest's plugin.schemas.input: what this workload accepts as a job payload. Optional, like workerDetail: an entry that always carried it would be a field an older consumer rejects.",
          "type": "object"
        },
        "configuration": {
          "description": "The stored configuration values this workload actually runs on, with every key named in secretConfigurationKeys withheld. Optional: absent when the manifest declares no configuration contract.",
          "type": "object"
        },
        "settingsRevision": {
          "description": "The stored settings revision these configuration values carry; 0 means the manifest defaults with no stored file. Optional: absent when the manifest declares no configuration contract.",
          "type": "integer",
          "minimum": 0
        },
        "secretConfigurationKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  }
}
