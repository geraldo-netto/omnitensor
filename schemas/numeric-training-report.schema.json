{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/omnitensor/numeric-training-report.schema.json",
  "title": "OmniTensor numeric training report common core",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "recipe",
    "quality",
    "model",
    "tensorContract",
    "outputContract",
    "targets"
  ],
  "properties": {
    "version": {"const": 1},
    "recipe": {
      "enum": [
        "backblaze-smart-risk-v1",
        "aggregate-reconstruction-v1",
        "metadata-risk-ranking-v1",
        "labelled-sensor-window-v1",
        "confirmed-layout-suggestion-v1"
      ]
    },
    "quality": {"$ref": "#/$defs/quality"},
    "model": {"$ref": "#/$defs/model"},
    "tensorContract": {"$ref": "#/$defs/tensorContract"},
    "outputContract": {"$ref": "#/$defs/outputContract"},
    "targets": {"$ref": "#/$defs/targets"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "filename", "sha256"],
      "properties": {
        "format": {"const": "onnx"},
        "filename": {"const": "model.onnx"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tensorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs"],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/input"}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "dtype", "layout"],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "prefixItems": [{"const": 1}],
          "items": {"type": "integer", "minimum": 1, "maximum": 65536}
        },
        "dtype": {"const": "float32"},
        "layout": {"const": "NC"}
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "raw"}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tpu", "npu", "gpu"],
      "properties": {
        "tpu": {"const": "uncompiled"},
        "npu": {"const": "uncompiled"},
        "gpu": {"const": "uncompiled"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "jsonValue": {
      "anyOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    }
  }
}
